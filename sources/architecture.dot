digraph Observatory {
  graph [bgcolor="transparent", rankdir=LR, pad="0.45", nodesep="0.52", ranksep="0.95", splines=spline, fontname="Avenir Next", label="REAL-TIME OCEAN OBSERVATORY", labelloc=t, fontsize=25, fontcolor="#eaf7ff"];
  node [shape=rect, style="rounded,filled", fillcolor="#14243ccc", color="#6e91a9", penwidth=1.5, fontname="Avenir Next", fontcolor="#e0eef7", margin="0.24,0.14"];
  edge [color="#6f91aa", penwidth=1.5, arrowsize=0.7, fontname="Avenir Next", fontcolor="#9db5c6", fontsize=10];

  subgraph cluster_edge {
    label="FIELD / EDGE"; color="#3a7280"; fontcolor="#71d5ca"; style="rounded,dashed";
    buoys [label="Sensor Buoys\n18 regions", fillcolor="#163c42cc", color="#54d6c6"];
    gliders [label="Autonomous Gliders\n6 transects", fillcolor="#163c42cc", color="#54d6c6"];
    satellite [label="Satellite Relay\nL-band", fillcolor="#163c42cc", color="#54d6c6"];
  }
  subgraph cluster_stream {
    label="STREAM FABRIC"; color="#4d5f9a"; fontcolor="#91a5ff"; style="rounded,dashed";
    ingest [label="Ingest Gateway\nvalidation + clock", fillcolor="#222c55cc", color="#7b9cff"];
    bus [label="Event Current\npartitioned log", shape=cylinder, fillcolor="#222c55cc", color="#7b9cff"];
    quality [label="Quality Engine\nphysics constraints", fillcolor="#222c55cc", color="#7b9cff"];
  }
  subgraph cluster_products {
    label="SCIENCE PRODUCTS"; color="#95536f"; fontcolor="#ff8ba5"; style="rounded,dashed";
    lake [label="Observation Lake\nversioned arrays", shape=cylinder, fillcolor="#49243acc", color="#ff6f91"];
    model [label="Assimilation Model\n4D ensemble", fillcolor="#49243acc", color="#ff6f91"];
    portal [label="Research Portal\nmap + notebook", fillcolor="#49243acc", color="#ff6f91"];
  }
  alert [label="Coastal Alerting\n< 90 s", fillcolor="#51431dcc", color="#ffd166", fontcolor="#fff0bd"];
  buoys -> ingest [label="acoustic"];
  gliders -> ingest [label="surfacing"];
  satellite -> ingest;
  ingest -> bus -> quality;
  quality -> lake;
  quality -> alert [color="#ffd166", penwidth=2.4];
  lake -> model -> portal;
  model -> alert [color="#ff9d79", style=dashed];
  portal -> model [label="scenarios", style=dashed, constraint=false];
}
